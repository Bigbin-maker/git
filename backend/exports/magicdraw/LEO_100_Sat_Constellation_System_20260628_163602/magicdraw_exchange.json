      "local_id": "REQ-001",
      "name": "星座规模与轨道要求",
      "type": "Requirement",
      "package": "01_Requirements",
      "metaclass": "Class",
      "stereotype": "SysML::Requirements::Requirement",
      "documentation": "星座由100颗低轨卫星组成，部署在多个轨道面，实现全球覆盖。轨道高度700-1200km，倾角≥80°以保证极地覆盖。基于对话“100颗卫星组成的低轨卫星总体方案”的核心目标。",
      "source_requirement": "REQ-001",
      "status": "candidate",
      "tags": {
        "ai_mbse_id": "REQ-001",
        "external_id": null,
        "package": "01_Requirements"
      }
    },
    {
      "local_id": "REQ-002",
      "name": "通信服务性能",
      "type": "Requirement",
      "package": "01_Requirements",
      "metaclass": "Class",
      "stereotype": "SysML::Requirements::Requirement",
      "documentation": "系统应提供下行速率不低于100Mbps、上行速率不低于20Mbps的单用户通信能力，端到端时延≤50ms（星间+网关）。假设为宽带互联网星座。",
      "source_requirement": "REQ-002",
      "status": "candidate",
      "tags": {
        "ai_mbse_id": "REQ-002",
        "external_id": null,
        "package": "01_Requirements"
      }
    },
    {
      "local_id": "REQ-003",
      "name": "卫星平台通用能力",
      "type": "Requirement",
      "package": "01_Requirements",
      "metaclass": "Class",
      "stereotype": "SysML::Requirements::Requirement",
      "documentation": "单星质量≤500kg，太阳翼输出功率≥2kW，具备自主轨道保持和避碰能力，设计寿命5-7年，寿命末期主动降轨。基于低轨小型通信卫星典型能力假设。",
      "source_requirement": "REQ-003",
      "status": "candidate",
      "tags": {
        "ai_mbse_id": "REQ-003",
        "external_id": null,
        "package": "01_Requirements"
      }
    },
    {
